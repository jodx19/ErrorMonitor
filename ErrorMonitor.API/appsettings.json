{
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft":             "Warning",
        "Microsoft.AspNetCore":  "Warning",
        "System":                "Warning"
      }
    }
  },

  "SeqSettings": {
    "ServerUrl": "http://localhost:5341"
  },

  "JwtSettings": {
    "SecretKey":      "ErrorMonitor-SuperSecret-Key-256bit-ForDev!",
    "Issuer":         "ErrorMonitor.API",
    "Audience":       "ErrorMonitor.Client",
    "ExpiryMinutes":  60
  }
}
